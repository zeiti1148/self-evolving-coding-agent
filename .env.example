# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/app.db

# Large language model API (example values only)
LLM_PROVIDER=example
LLM_API_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace_with_your_api_key
LLM_MODEL=example-model
LLM_TIMEOUT_SECONDS=60
# Direct by default. true opts into HTTP(S)_PROXY / ALL_PROXY / NO_PROXY and SSL_CERT_*.
# HTTPS certificate verification remains enabled in both modes.
LLM_TRUST_ENV=false
# Total cooperative task budget, including final verification and extraction.
TASK_TIMEOUT_SECONDS=600
# Set false to disable retrieval/injection; successful repairs still save experience.
USE_EXPERIENCE=true

# Optional; relative paths are resolved from the repository root.
WORKSPACE_ROOT=runtime/workspaces
MAVEN_HOME=.cache/maven/apache-maven-3.9.11

# Frontend configuration belongs to frontend/.env.local, never put API keys there.
