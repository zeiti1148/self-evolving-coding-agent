# Mock mode works without FastAPI, Java or an LLM. Change to false for integration.
VITE_USE_MOCK=true
# Empty uses the current origin. Vite forwards /api during development.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:8000
# Registered backend project identifier. The second benchmark is java-null-profile.
VITE_SOURCE_PROJECT=java-null-greeting
VITE_SOURCE_PROJECT_LABEL=Java 空指针修复样例
